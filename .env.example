# Plantilla de /opt/cdf/.env (permisos 600, fuera del repositorio). Sin valores: nunca se rellenan aquí.
# run_scraper.sh carga este fichero con «. .env»: usa valores sin espacios ni comillas
# (por ejemplo, generados con  openssl rand -hex 32).

# --- Scrapers (ya en uso en el servidor)
BUCKET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Postgres (hito 0, segunda parte)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Copias de Postgres: frase de cifrado. Guárdala TAMBIÉN fuera del servidor: sin ella las copias no sirven.
BACKUP_PASSPHRASE=

# --- rclone: nombre del remoto del bucket (el mismo que usa run_scraper.sh) y su configuración en el host
RCLONE_REMOTE=
RCLONE_CONF_HOST=
