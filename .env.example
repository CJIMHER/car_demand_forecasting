# Plantilla de /opt/cdf/.env (permisos 600, fuera del repositorio). Sin valores: nunca se rellenan aquí.
# run_scraper.sh carga este fichero con «. .env» y docker compose lo lee como env_file: usa valores
# sin espacios, comillas ni «$» (por ejemplo, generados con  openssl rand -hex 32).

# --- Scrapers (ya en uso en el servidor)
BUCKET=

# --- Telegram: avisos de los scrapers y resumen diario de las 09:00
TELEGRAM_BOT_TOKEN=
# Chat del rol técnico (avisos de los scrapers, la copia y las alertas técnicas)
TELEGRAM_CHAT_ID=
# Chats de las alertas de cada rol y de los botones de Ventas. Si falta uno, sus mensajes van al chat
# del técnico con el rol delante.
TELEGRAM_CHAT_DIRECCION=
TELEGRAM_CHAT_VENTAS=
TELEGRAM_CHAT_MARKETING=
# Alertas calculadas sobre datos de ejemplo (solo para el técnico): con 1 también se envían por
# Telegram; vacío, solo se guardan y se ven en el panel
ALERTAS_ENVIAR_EJEMPLO=

# --- rclone: el remoto del bucket se define con variables, sin fichero rclone.conf.
# Son las que ya usa run_scraper.sh para el remoto «hz» (las que tenga el servidor; por ejemplo):
RCLONE_REMOTE=
RCLONE_CONFIG_HZ_TYPE=
RCLONE_CONFIG_HZ_PROVIDER=
RCLONE_CONFIG_HZ_ACCESS_KEY_ID=
RCLONE_CONFIG_HZ_SECRET_ACCESS_KEY=
RCLONE_CONFIG_HZ_ENDPOINT=

# --- Postgres (hito 0, segunda parte)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Copias de Postgres: frase de cifrado. Guárdala TAMBIÉN fuera del servidor: sin ella las copias no sirven.
BACKUP_PASSPHRASE=

# --- Panel (hito 1b). Con PANEL_DOMINIO vacío, make deploy no arranca ni el panel ni Caddy.
# Subdominio propio del panel (registro DNS A al servidor); Caddy saca su certificado HTTPS.
PANEL_DOMINIO=
# Contraseña del usuario de Postgres del panel (cdf_panel), con  openssl rand -hex 32
PANEL_DB_PASSWORD=
# Días sin actividad tras los que caduca una sesión (vacío: 30)
PANEL_SESION_DIAS=
# Datos de ejemplo de Dirección, Ventas y Marketing (make ejemplo-cargar / ejemplo-borrar): solo con 1
PANEL_PERMITE_EJEMPLO=
# Roles que ven una vista con algún bloque de ejemplo, separados por comas (vacío: tecnico)
PANEL_EJEMPLO_VISIBLE_PARA=

# --- Conectores (hito 1b, sesión 3). Sin valores no hacen ninguna petición («sin credenciales»).
# Meta Marketing API, solo lectura (permiso ads_read): token de un usuario del sistema y cuenta publicitaria
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# GA4 Data API, solo lectura (cuenta de servicio con el rol Lector de la propiedad). El fichero JSON va
# en /opt/cdf/secretos/ (permisos 600, de cdf); aquí, su ruta dentro del contenedor: /secretos/<fichero>.json
GA4_PROPERTY_ID=
GA4_CREDENCIALES=
