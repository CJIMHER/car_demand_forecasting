# Tareas del contenedor cdf_jobs (hora de Madrid). Formato /etc/cron.d: minuto hora dom mes dsem usuario orden
# Scrapers en el host (systemd): VO 04:00, VN 05:30, VN otros 06:45, con hasta 4 intentos.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Conectores de Meta y GA4: recargan los últimos 7 días (sin credenciales no hacen nada)
0 6 * * * cdf /app/infra/jobs/tarea.sh meta
10 6 * * * cdf /app/infra/jobs/tarea.sh ga4
# API de Walcu: carga incremental de coches, leads y citas, después de su sincronización con la web (06:00)
30 6 * * * cdf /app/infra/jobs/tarea.sh walcu_api
# Google Trends: carga la última entrega subida a mano (si ya está cargada, no hace nada nuevo)
0 7 * * * cdf /app/infra/jobs/tarea.sh gtrends
# Carga de las tres bases SQLite a Postgres, cuando ya han podido terminar los reintentos
30 8 * * * cdf /app/infra/jobs/tarea.sh cargar
# Comprobación: carga lo que falte y anota en fuentes_estado si un scraper no tiene captura del día
0 9 * * * cdf /app/infra/jobs/tarea.sh comprobar
# Precálculo del panel (tablas panel_mercado_*): los 8 últimos días, con la carga ya comprobada; después, la
# previsión de leads, citas y ventas de Meta (analitica/prevision.py)
10 9 * * * cdf /app/infra/jobs/tarea.sh precalcular
# Motor de alertas y envío por Telegram por rol, con el precálculo ya hecho
15 9 * * * cdf /app/infra/jobs/tarea.sh alertas
# Avisos de los botones de Ventas (el panel no tiene el token de Telegram): cada minuto
* * * * * cdf /app/infra/jobs/tarea.sh avisos
# Copia cifrada de Postgres al bucket, con la carga del día ya dentro
30 9 * * * cdf /app/infra/jobs/tarea.sh copia
